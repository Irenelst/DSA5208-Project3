
#!/bin/bash
#PBS -N serial3d_formal
#PBS -P personal-e0869267
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:10:00
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=6gb

set -euo pipefail

cd "$PBS_O_WORKDIR"

module purge
module load intel/2024a

echo "===== 3D Serial Scaling Formal Experiment ====="
echo "Hostname: $(hostname)"
echo "Date: $(date)"
echo

mkdir -p results

bash scripts/serial/run_serial_scaling.sh \
    3D \
    1000 \
    5 \
    results/serial_3d.csv \
    32 64 128 256

echo "===== 3D Serial Scaling Completed ====="
