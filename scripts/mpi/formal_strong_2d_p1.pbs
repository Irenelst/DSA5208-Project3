
#!/bin/bash
#PBS -N strong2d_p1
#PBS -P personal-e0869267
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:10:00
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=6gb

cd $PBS_O_WORKDIR

module purge
module load intel/2024a

echo "===== 2D MPI Strong Scaling Formal Experiment: P=1 ====="
echo "Hostname: $(hostname)"
echo "Date: $(date)"
echo

mkdir -p results

bash scripts/mpi/run_mpi_repeats.sh \
    strong \
    2D \
    8192 \
    1000 \
    1 \
    5 \
    results/strong_2d.csv

