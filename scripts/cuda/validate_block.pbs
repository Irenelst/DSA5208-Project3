
#!/bin/bash
#PBS -N poisson_block_validate
#PBS -q auto_free
#PBS -l select=1:ncpus=4:ngpus=1:mem=8gb
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

# Run from repository root
cd "$PBS_O_WORKDIR"

# Load CUDA environment
module load cuda12.4/toolkit/12.4.1

echo "=== GPU Information ==="
hostname
nvidia-smi

echo "=== 2D Block Validation ==="

./bin/poisson_2d_cuda_block validation 16 32 8

echo "=== 3D Block Validation ==="

./bin/poisson_3d_cuda_block validation 16 8 8 8

echo "=== ALL VALIDATIONS COMPLETED ==="
